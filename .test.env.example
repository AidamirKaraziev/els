# Скопируйте в `.test.env` в корне репозитория (файл в .gitignore).
# Укажите отдельную БД PostgreSQL только для pytest — не боевую.

MODE=TEST
DB_HOST=localhost
DB_PORT=5432
DB_USER=lift_test
DB_PASS=lift_test
DB_NAME=lift_test

# Стабильный ключ нужен для детерминированных JWT в тестах (пример).
SECRET_KEY=test-secret-key-change-in-real-env

