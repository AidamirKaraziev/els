{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "schedule-object-preview",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/schedule_object_preview.dart",
        "-d",
        "web-server",
        "--web-port",
        "5599",
        "--web-hostname",
        "127.0.0.1"
      ],
      "cwd": "frontend",
      "port": 5599
    },
    {
      "name": "schedule-wizard-preview",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/schedule_wizard_preview.dart",
        "-d",
        "web-server",
        "--web-port",
        "5600",
        "--web-hostname",
        "127.0.0.1"
      ],
      "cwd": "frontend",
      "port": 5600
    },
    {
      "name": "schedule-wizard-live",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/schedule_wizard_live.dart",
        "-d",
        "web-server",
        "--web-port",
        "5601",
        "--web-hostname",
        "127.0.0.1",
        "--dart-define=API_ORIGIN=http://localhost:8080"
      ],
      "cwd": "frontend",
      "port": 5601
    }
  ]
}
