# Скопируйте в `.test.env` в корне репозитория (файл в .gitignore).
# Эти же переменные читает `docker-compose.test.yml`, поэтому порт и имя базы
# менять можно — контейнер поднимется с ними же (`make test-db-up`).
#
# ВАЖНО: база должна быть отдельной, только для pytest. Перед каждым прогоном
# conftest делает DROP SCHEMA public, поэтому боевую БД сюда указывать нельзя.
# Предохранитель в `tests/conftest.py` требует MODE=TEST и слово "test" в DB_NAME.

MODE=TEST
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASS=postgres
DB_NAME=test_postgres

# Стабильный ключ нужен для детерминированных JWT в тестах (пример).
# В отличие от прежнего поведения, ключ обязателен: дефолта у него больше нет.
SECRET_KEY=test-secret-key-change-in-real-env

# Первый администратор. Создаётся только если в базе нет ни одного админа.
# Дефолтные значения из `config.py` приложение не принимает — с ними старт
# падает, потому что это открытый вход с полными правами.
FIRST_SUPERUSER=superadmin@els-test.ru
FIRST_SUPERUSER_PASSWORD=test-superuser-password

# Домены, которым разрешён доступ к API из браузера. Пусто = любой домен
# (прежнее поведение) с выключенными credentials. В проде заполнять обязательно:
# BACKEND_CORS_ORIGINS=https://els.example.ru,https://admin.els.example.ru
BACKEND_CORS_ORIGINS=
